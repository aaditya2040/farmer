# ==========================================
# KisanSetu MSG91 Credentials Configuration
# ==========================================
# IMPORTANT: Keep this file secure and NEVER commit your real .env file.

# 1. MSG91 Authentication Key (Created as 'KisanSetu' in MSG91 Dashboard)
MSG91_AUTH_KEY=YOUR_MSG91_AUTHKEY_HERE

# 2. MSG91 OTP Service Configuration
# Create an OTP Template in MSG91 (under OTP service): e.g. "Your OTP for KisanSetu login is ##OTP##. Valid for 10 mins."
MSG91_OTP_TEMPLATE_ID=YOUR_OTP_TEMPLATE_ID_HERE

# 3. 6-Character Sender ID (e.g., KSANST, GOVMHD, or default sender ID registered on DLT)
MSG91_SENDER_ID=KSANST

# 4. MSG91 Flow / Template ID for Slot Confirmation SMS
# e.g., "KisanSetu: Your slot for ##crop## is booked at ##centre## for ##date## ##time##. Token: ##token##."
MSG91_SLOT_TEMPLATE_ID=YOUR_SLOT_CONFIRMATION_FLOW_ID_HERE

# 5. MSG91 Flow / Template ID for Live Queue Alert SMS
# e.g., "KisanSetu Alert: Your Token ##token## is approaching. Only ##ahead## tokens remaining before your turn at ##centre##."
MSG91_QUEUE_TEMPLATE_ID=YOUR_QUEUE_ALERT_FLOW_ID_HERE

# 6. Backend Server Port
PORT=3001
